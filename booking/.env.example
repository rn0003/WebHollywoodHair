# Copy to .env.local for local testing. In production set these in the host's
# environment-variable settings. Never commit real values.

# Yahoo account that owns the salon calendar
CALDAV_USERNAME=
# Yahoo *app password* (Account Security → Generate app password), NOT the normal password
CALDAV_PASSWORD=
# Optional: calendar name as shown in Yahoo Calendar. Defaults to the first calendar.
CALENDAR_NAME=AnnaCalendar
# Optional: CalDAV server. Defaults to Yahoo.
CALDAV_URL=https://caldav.calendar.yahoo.com

SALON_TIMEZONE=America/Chicago

# Recommended in production: your site's address(es), comma-separated
ALLOWED_ORIGINS=http://hollywood-hairsalon.com

# Optional bot protection (Cloudflare Turnstile, free)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
